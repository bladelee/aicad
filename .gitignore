# ========================================
# macOS
# ========================================
.DS_Store
._*

# 软链（向后兼容入口，Windows clone 会变成无效文件，不入库）
dwg

# samples 里的二次备份（与外层同名 DWG 重复，外层已是只读原件）
samples/**/_原始备份/

# ========================================
# Python
# ========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.eggs/
build/
dist/
.coverage
htmlcov/

# ========================================
# VS Code / Editor
# ========================================
.vscode/
.idea/
*.swp
*.swo

# ========================================
# 项目临时调研产物（不入库，可安全删除）
# ========================================
tmp_aspose_wheel/
tmp_oda_search/
tmp_vision/

# 归档目录里的 ODA 实验二进制残骸（81MB AppImage + 54MB deb）
# 已确认 ODA 27.x CLI 不可用，源码脚本保留但二进制包不入库
docs/99-归档/oda-experiments/oda_pkg/*.AppImage
docs/99-归档/oda-experiments/oda_pkg/*.deb

# ========================================
# 运行期工作产物（大量中间文件，不入库；可用 tools/ 一键复现）
# ========================================

# DXF 转换产物（134MB，可用 tools/dwg_to_dxf/convert_dwg.sh 从 samples/ 复现）
workdir/19-102/dxf/*.dxf

# 改图前的备份
workdir/19-102/backups/

# 演示输出产物
workdir/19-102/demo_outputs/

# scan_report.json 体积小，保留作为参考（如不想保留可取消下一行注释）
# workdir/19-102/scan_report.json

# ========================================
# Docker 镜像 tar（不入库，从 ghcr.io 拉）
# ========================================
*.tar
*.tar.gz

# ========================================
# 日志 / 临时
# ========================================
*.log
/tmp_*/

# ========================================
# 样本数据策略：samples/19-102/ 的原始 DWG/PDF（约 18MB）
# 大文件用 Git LFS 管理，已在 .gitattributes 配置
# ========================================

# 根目录隐藏临时调试脚本
/.tmp_*
